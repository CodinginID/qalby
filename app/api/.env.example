# Google OAuth — Client ID dari Google Cloud Console
# (sama dengan yang dipakai di GoogleService-Info.plist / google-services.json)
GOOGLE_CLIENT_ID=182949033056-xxxxxxxxxx.apps.googleusercontent.com

# JWT — secret untuk sign session token (generate random string yang panjang)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# App
APP_ENV=development
APP_PORT=8000

# MongoDB
MONGO_PORT=37017
MONGO_INITDB_DATABASE=qalby
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=qalby

# Future Features — isi jika sudah siap
# AI Recitation: analisis tajwid dari audio
# Smart Recommendation: rekomendasi personal berdasarkan riwayat belajar
# Adaptive Reminder: jadwal pengingat adaptif berdasarkan kebiasaan user
GEMINI_API_KEY=
OPENAI_API_KEY=
